# ReachInbox Email Job Scheduler Configuration

# General
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# Security Secrets (Replace with strong random values in production/strict mode; >= 32 chars)
SESSION_SECRET=replace-with-strong-session-secret-at-least-32-characters
ENCRYPTION_KEY=replace_with_64_hex_chars_for_32_byte_aes_256_gcm_encryption_key

# Strict Infrastructure & Auth Controls
# Set STRICT_INFRASTRUCTURE=true and ALLOW_EMBEDDED_FALLBACK=false to require live PostgreSQL and Redis without fallback
STRICT_INFRASTRUCTURE=false
ALLOW_EMBEDDED_FALLBACK=true
STRICT_AUTH=false

# Primary Datastores (PostgreSQL 16 + Redis 7 AOF + Elasticsearch 8.12)
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox
POSTGRES_DB=reachinbox
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://127.0.0.1:6379
ELASTICSEARCH_URL=http://localhost:9200
ES_EMAILS_INDEX=emails

# Queue & Throughput Bounds
QUEUE_NAME=email-send
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
RATE_LIMIT_LOOKAHEAD_WINDOWS=72
EMAIL_MAX_ATTEMPTS=3
STALE_CLAIM_MS=120000
MAX_LEADS_PER_REQUEST=5000
ENQUEUE_CHUNK_SIZE=500

# Ethereal SMTP (Optional static test account; auto-provisions if empty)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=

# Google OAuth 2.0 / OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Slack OAuth 2.0 & Webhook Alerts
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/auth/slack/callback
SLACK_SCOPES=incoming-webhook,chat:write

# Bull Board Queue Admin UI Credentials (Change before production/strict deployment; >= 8 chars)
BULL_BOARD_USER=admin
BULL_BOARD_PASS=change-me-strong-admin-password

# Demo mode (accelerated intervals for live evaluation)
DEMO_FAST_MODE=false
